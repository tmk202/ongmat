---
/**
 * Astro 7 Static Entry Page (`src/pages/index.astro`)
 * - Pure CSS (`src/styles/cabinet.css`) — Zero Tailwind
 * - Visual-First Curiosity Cabinet & 3D Sculpture Motion Experience:
 *   1. Hero 100dvh Cyber-Bee Harvester + 4 3D Platform Sculptures
 *   2. Live Interactive Honey-Data Refinery Canvas (`RefineryCanvasEngine`)
 *   3. 3D Floating Platform Telemetry Pedestals (Shopee, TikTok, Amazon, Lazada)
 *   4. 4 3D Glass Specimen Domes with Floating 3D Sculptures & Golden Honey Orbs
 *   5. 4 3D Extruded Mechanical Service Sculptures (Scraper Claw, Planetary Sync, Neural Cube, Nectar Torus)
 *   6. Interactive Bee-Swarm Mission Dispenser Canvas (`MissionSwarmEngine`)
 */
import '../styles/cabinet.css';
import shopeePod from '../data/shopee-tiktok-gmv-pod.json';
import amazonTerminal from '../data/amazon-shopify-buybox-terminal.json';
import tiktokVault from '../data/tiktok-shop-live-telemetry.json';
import etsyHub from '../data/etsy-lazada-omni-hub.json';
import { buildHomeJsonLd, DEFAULT_DESCRIPTION, DEFAULT_TITLE, SITE_ORIGIN } from '../seo/seoHead';

const jsonLd = JSON.stringify(buildHomeJsonLd());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{DEFAULT_TITLE}</title>
    <meta name="description" content={DEFAULT_DESCRIPTION} />
    <link rel="canonical" href={`${SITE_ORIGIN}/`} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${SITE_ORIGIN}/`} />
    <meta property="og:site_name" content="ecommarketdata" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={DEFAULT_TITLE} />
    <meta property="og:description" content={DEFAULT_DESCRIPTION} />
    <meta property="og:image" content={`${SITE_ORIGIN}/og-default.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ecommarketdata — Global E-Commerce Market Intelligence" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={DEFAULT_TITLE} />
    <meta name="twitter:description" content={DEFAULT_DESCRIPTION} />
    <meta name="twitter:image" content={`${SITE_ORIGIN}/og-default.png`} />
    <meta name="twitter:image:alt" content="ecommarketdata — Global E-Commerce Market Intelligence" />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <main class="landing-page">
      <!-- ====================================================================
           SECTION 1: THE CURIOSITY CABINET (Interactive Hero 100dvh)
           ==================================================================== -->
      <section class="cabinet-hero" id="cabinet-hero">
        <div class="frame">
          <header class="top-nav">
            <a href="/" class="logo-box">
              <img id="astro-logo-back" alt="" width="53" height="41" class="logo-folder-back" />
              <img id="astro-logo-front" alt="" width="53" height="34" class="logo-folder-front" />
              <span class="logo-word" data-web-anchor>ecommarketdata</span>
            </a>
            <nav class="nav-links" aria-label="Primary Navigation">
              <a href="/" class="nav-link active" data-web-anchor>home</a>
              <div class="nav-drop">
                <button
                  type="button"
                  class="nav-link nav-drop-trigger"
                  aria-expanded="false"
                  aria-controls="services-menu"
                  data-web-anchor
                >
                  services
                </button>
                <div class="nav-drop-panel" id="services-menu">
                  <span class="nav-drop-label">Services</span>
                  <a href="/services/#web-scraping-data-extraction">Web Scraping &amp; Data Extraction</a>
                  <a href="/services/#business-process-automation">Business Process Automation</a>
                  <a href="/services/#ai-agents-intelligent-workflows">AI Agents &amp; Intelligent Workflows</a>
                  <a href="/services/#custom-apis-data-pipelines">Custom APIs &amp; Data Pipelines</a>
                  <a class="nav-drop-all" href="/services/">All services →</a>
                </div>
              </div>
              <a href="/pricing/" class="nav-link" data-web-anchor>pricing</a>
              <a href="/dashboard/" class="nav-link" data-web-anchor>dashboard</a>
              <a href="/blog/" class="nav-link" data-web-anchor>blog</a>
              <a href="/policy/" class="nav-link" data-web-anchor>policy</a>
              <a href="/about/" class="nav-link" data-web-anchor>about</a>
            </nav>
          </header>

          <h1 class="found" data-web-anchor>
            <span>ec</span><span class="letter-o">o</span><span>m</span>
            <span class="found-sub-tag">marketdata</span>
          </h1>

          <a href={`/data/${shopeePod.slug}`} aria-label={shopeePod.title}>
            <img id="astro-obj-mug" alt={shopeePod.title} width="300" height="300" class="cabinet-obj obj-mug" data-web-anchor />
          </a>
          <a href={`/data/${amazonTerminal.slug}`} aria-label={amazonTerminal.title}>
            <img id="astro-obj-ibook" alt={amazonTerminal.title} width="312" height="377" class="cabinet-obj obj-ibook" data-web-anchor />
          </a>
          <a href={`/data/${tiktokVault.slug}`} aria-label={tiktokVault.title}>
            <img id="astro-obj-book" alt={tiktokVault.title} width="293" height="322" class="cabinet-obj obj-book" data-web-anchor />
          </a>
          <a href={`/data/${etsyHub.slug}`} aria-label={etsyHub.title}>
            <img id="astro-obj-tshirt" alt={etsyHub.title} width="280" height="260" class="cabinet-obj obj-tshirt" data-web-anchor data-stick="bottom" />
          </a>

          <h2 class="cabinet" data-web-anchor>the curiosity<br />cabinet</h2>
          <p class="tagline" data-web-anchor>Deep e-commerce market intelligence for modern enterprises.</p>
        </div>

        <canvas id="astro-web-canvas" class="web-layer"></canvas>

        <div class="over" aria-hidden="true">
          <div class="found">
            <span>ec</span><span class="letter-o">o</span><span>m</span>
            <span class="found-sub-tag">marketdata</span>
          </div>
        </div>
      </section>

      <!-- ====================================================================
           VISUAL-FIRST 3D & MOTION SECTIONS
           ==================================================================== -->
      <div class="landing-content">
        <!-- ==================================================================
             SECTION 2: INTERACTIVE HONEY-DATA REFINERY CANVAS
             ================================================================== -->
        <section class="landing-section" id="harvester-pipeline">
          <div class="landing-section-header">
            <h2 class="landing-title">Raw Commerce Signals, Refined &amp; Delivered</h2>
            <p class="landing-subtitle">
              We capture, normalize, and enrich real-time telemetry across global marketplaces and social commerce—streaming clean, schema-ready intelligence directly into your enterprise data warehouse, BI stack, and AI models.
            </p>
          </div>

          <!-- Full Interactive 60fps Canvas 2D Refinery -->
          <div class="refinery-canvas-stage">
            <canvas id="refinery-canvas" class="refinery-canvas-el"></canvas>
          </div>
        </section>

        <!-- ==================================================================
             SECTION 3: HOW WE WORK — REACTBITS PRO HOW-IT-WORKS-8
             ================================================================== -->
        <section class="landing-section hiw8-section" id="telemetry" aria-labelledby="hiw8-heading">
          <div class="hiw8-container">
            <div class="hiw8-header">
              <h2 id="hiw8-heading" class="hiw8-heading">How we work</h2>
              <p class="hiw8-subheading">
                Tell us the platform, the business use case, and the data fields you need — any marketplace, any industry, any spec. We take it all, then design, build, and ship it as a service.
              </p>
              <span class="hiw8-flow">You request &rarr; We engineer &rarr; You pull</span>
              <a href="#contact" class="hiw5-cta">Get Started</a>
              <p class="hiw5-note">Need a custom dataset or feed? <a href="#contact">Contact us</a>.</p>
            </div>

            <ol class="hiw8-grid">
              <li class="hiw8-step">
                <span class="hiw8-step-badge">1</span>
                <div class="hiw8-step-body">
                  <h3 class="hiw8-step-title">You request</h3>
                  <p class="hiw8-step-copy">
                    Name the platform, product category, or niche — any marketplace, any industry, any fields. Scope, history, refresh cadence, and format are yours to define.
                  </p>
                </div>
              </li>

              <li class="hiw8-step">
                <span class="hiw8-step-badge">2</span>
                <div class="hiw8-step-body">
                  <h3 class="hiw8-step-title">We analyze the logic</h3>
                  <p class="hiw8-step-copy">
                    We break down the business rules, model the entities, and design the extraction algorithm that turns raw marketplace signals into clean, typed data. Typical timeline: <strong>2–5 business days</strong>.
                  </p>
                  <p class="hiw8-step-note">Actual analysis time depends on the complexity of the business use case.</p>
                </div>
              </li>

              <li class="hiw8-step">
                <span class="hiw8-step-badge">3</span>
                <div class="hiw8-step-body">
                  <h3 class="hiw8-step-title">We build &amp; ship the service</h3>
                  <p class="hiw8-step-copy">
                    Pipelines are auto-generated and hardened, then exposed as a production-ready API — with retries, deduplication, and schema guarantees included.
                  </p>
                </div>
              </li>

              <li class="hiw8-step">
                <span class="hiw8-step-badge">4</span>
                <div class="hiw8-step-body">
                  <h3 class="hiw8-step-title">You pull on schedule</h3>
                  <p class="hiw8-step-copy">
                    Call the endpoint on your own cadence and receive fresh, schema-ready data every time — zero maintenance on your side.
                  </p>
                </div>
              </li>
            </ol>
          </div>
        </section>

        <!-- ==================================================================
             SECTION 4: FINAL ENTERPRISE CTA & STUDIO DISPATCH CONSOLE
             ================================================================== -->
        <section class="landing-section" id="contact" style="border-bottom: none; padding-top: 24px;">
          <div class="cta-split-showcase">
            <!-- Left Column: Headline + Frameless 3D Hive Centerpiece + SLA Pills -->
            <div class="cta-showcase-left">
              <h2 id="cta-rising-ink-title" class="final-cta-title">Ready to Receive Guaranteed Commerce Data?</h2>
              <p class="final-cta-sub">
                Get a tailored sample dataset or connect your enterprise warehouse in under 24 hours.
              </p>

              <div class="cta-visual-centerpiece">
                <canvas id="mission-swarm-canvas" class="mission-swarm-canvas"></canvas>
              </div>
            </div>

            <!-- Right Column: Architectural Glass Console Form -->
            <form id="enterprise-lead-form" class="cta-console-card" novalidate>
              <div class="cta-form-grid">
                <div class="cta-field">
                  <label class="cta-label" for="lead-name">Full Name &amp; Company *</label>
                  <div class="cta-input-shell">
                    <svg class="cta-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                      <circle cx="12" cy="7" r="4" />
                    </svg>
                    <input
                      id="lead-name"
                      name="name"
                      type="text"
                      required
                      class="cta-input"
                      placeholder="Alex Morgan · Acme Corp"
                    />
                  </div>
                </div>

                <div class="cta-field">
                  <label class="cta-label" for="lead-email">Work Email *</label>
                  <div class="cta-input-shell">
                    <svg class="cta-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="2" y="4" width="20" height="16" rx="3" />
                      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                    </svg>
                    <input
                      id="lead-email"
                      name="email"
                      type="email"
                      required
                      class="cta-input"
                      placeholder="alex@company.com"
                    />
                  </div>
                </div>

                <div class="cta-field cta-field-full">
                  <label class="cta-label" for="lead-telegram">Telegram / Phone</label>
                  <div class="cta-input-shell">
                    <svg class="cta-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m22 2-7 20-4-9-9-4Z" />
                      <path d="M22 2 11 13" />
                    </svg>
                    <input
                      id="lead-telegram"
                      name="telegram"
                      type="text"
                      class="cta-input"
                      placeholder="@username or +84..."
                    />
                  </div>
                </div>

                <div class="cta-field cta-field-full">
                  <label class="cta-label" for="lead-platforms">Target Marketplaces</label>
                  <div class="cta-input-shell">
                    <svg class="cta-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10" />
                      <path d="M2 12h20" />
                      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                    </svg>
                    <input
                      id="lead-platforms"
                      name="platforms"
                      type="text"
                      class="cta-input"
                      placeholder="Type any platform — e.g. Shopee, TikTok Shop, Tokopedia, Amazon..."
                    />
                  </div>
                </div>

                <div class="cta-field cta-field-full">
                  <label class="cta-label" for="lead-message">Data Scope &amp; Historical Depth</label>
                  <textarea
                    id="lead-message"
                    name="message"
                    rows="2"
                    class="cta-textarea"
                    placeholder="e.g. 36-month historical GMV, daily SKU pricing & brand share..."
                  ></textarea>
                </div>
              </div>

              <div class="cta-submit-row">
                <button type="submit" id="lead-submit-btn" class="specular-button specular-button--lg">
                  <canvas class="specular-button__light" aria-hidden="true"></canvas>
                  <span class="specular-button__label">
                    <span id="lead-submit-text">Request Free Sample Dataset</span>
                  </span>
                </button>
              </div>

              <div id="lead-feedback-banner" class="cta-feedback-banner" role="status" aria-live="polite"></div>
            </form>
          </div>

          <!-- ReactBits Pro Footer 8 -->
          <footer id="rb-footer8" class="rb-footer8">
            <div class="rb-f8-container">
              <div class="rb-f8-grid">
                <!-- Col 1: Brand Tagline + 4 Social Icon Buttons -->
                <div class="rb-f8-brand-col rb-f8-anim rb-f8-d0">
                  <p class="rb-f8-tagline">
                    ecommarketdata is the modern and intuitive way to model &amp; receive guaranteed commerce intelligence.
                  </p>
                  <div class="rb-f8-socials">
                    <a href="https://x.com" target="_blank" rel="noopener noreferrer" class="rb-f8-social-btn" aria-label="X">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                      </svg>
                    </a>
                    <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="rb-f8-social-btn" aria-label="Instagram">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <rect x="3" y="3" width="18" height="18" rx="5" />
                        <circle cx="12" cy="12" r="4" />
                        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
                      </svg>
                    </a>
                    <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="rb-f8-social-btn" aria-label="YouTube">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M23.5 6.5a3 3 0 0 0-2.1-2.1C19.5 4 12 4 12 4s-7.5 0-9.4.4A3 3 0 0 0 .5 6.5C0 8.4 0 12 0 12s0 3.6.5 5.5a3 3 0 0 0 2.1 2.1C4.5 20 12 20 12 20s7.5 0 9.4-.4a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.5.5-5.5s0-3.6-.5-5.5zM9.6 15.6V8.4l6.4 3.6z" />
                      </svg>
                    </a>
                    <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="rb-f8-social-btn" aria-label="LinkedIn">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zm7 0h3.8v1.7h.05c.53-1 1.84-2.05 3.78-2.05 4.04 0 4.78 2.66 4.78 6.12V21h-4v-5.5c0-1.3-.02-3-1.83-3s-2.11 1.43-2.11 2.9V21h-4z" />
                      </svg>
                    </a>
                  </div>
                </div>

                <!-- Col 2: Product -->
                <div class="rb-f8-link-col rb-f8-anim rb-f8-d1">
                  <h4 class="rb-f8-col-title">Product</h4>
                  <ul class="rb-f8-link-list">
                    <li class="rb-f8-link-item">
                      <a href="/data/" class="rb-f8-link">Datasets Catalog</a>
                    </li>
                    <li class="rb-f8-link-item">
                      <a href="/services/" class="rb-f8-link">Data Pipelines</a>
                    </li>
                    <li class="rb-f8-link-item">
                      <a href="/pricing/" class="rb-f8-link">Pricing</a>
                    </li>
                  </ul>
                </div>

                <!-- Col 3: Resources -->
                <div class="rb-f8-link-col rb-f8-anim rb-f8-d2">
                  <h4 class="rb-f8-col-title">Resources</h4>
                  <ul class="rb-f8-link-list">
                    <li class="rb-f8-link-item">
                      <a href="/dashboard/" class="rb-f8-link">Live Dashboard</a>
                    </li>
                    <li class="rb-f8-link-item">
                      <a href="/methodology/" class="rb-f8-link">Methodology</a>
                    </li>
                    <li class="rb-f8-link-item">
                      <a href="/blog/" class="rb-f8-link">Research Journal</a>
                    </li>
                  </ul>
                </div>

                <!-- Col 4: Company -->
                <div class="rb-f8-link-col rb-f8-anim rb-f8-d3">
                  <h4 class="rb-f8-col-title">Company</h4>
                  <ul class="rb-f8-link-list">
                    <li class="rb-f8-link-item">
                      <a href="/about/" class="rb-f8-link">About</a>
                    </li>
                    <li class="rb-f8-link-item">
                      <a href="#contact" class="rb-f8-link">Free Sample</a>
                      <span class="rb-f8-badge">24h sync</span>
                    </li>
                  </ul>
                </div>
              </div>

              <!-- Giant Outlined Fading Wordmark (Synced with Section 1 Cobalt Logo) -->
              <div class="rb-f8-wordmark-wrap" aria-hidden="true">
                <div class="rb-f8-wordmark">ecommarketdata</div>
              </div>

              <!-- Bottom Bar -->
              <div class="rb-f8-bottom">
                <p class="rb-f8-copy">© {new Date().getFullYear()} ecommarketdata / Guaranteed commerce intelligence</p>
                <div class="rb-f8-legal">
                  <a href="/methodology/" class="rb-f8-legal-link">Security</a>
                  <a href="/policy/" class="rb-f8-legal-link">Terms of service</a>
                  <a href="/policy/" class="rb-f8-legal-link">Privacy policy</a>
                </div>
              </div>
            </div>
          </footer>
        </section>
      </div>
    </main>

    <script>
      import { getCabinetAssets } from '../assets/cabinetSprites';
      import { SpiderCabinetEngine } from '../engine/spiderEngine';
      import {
        RefineryCanvasEngine,
        MissionSwarmEngine,
        RisingInkEngine,
        SpecularButtonEngine,
      } from '../engine/refineryCanvasEngine';

      // 1. Bind all 3D Extruded Sculptures in Hero
      const assets = getCabinetAssets();
      const bindImg = (id: string, src: string) => {
        const el = document.getElementById(id) as HTMLImageElement | null;
        if (el) el.src = src;
      };

      bindImg('astro-logo-back', assets.logoBackUrl);
      bindImg('astro-logo-front', assets.logoFrontUrl);
      bindImg('astro-obj-mug', assets.mugUrl);
      bindImg('astro-obj-ibook', assets.ibookUrl);
      bindImg('astro-obj-book', assets.bookUrl);
      bindImg('astro-obj-tshirt', assets.tshirtUrl);

      // 2. Mount Hero Curiosity Cabinet Engine
      const heroCanvas = document.getElementById('astro-web-canvas') as HTMLCanvasElement | null;
      if (heroCanvas) {
        new SpiderCabinetEngine(heroCanvas, assets);
      }

      // 3. Mount Section 2 Live Honey-Data Refinery Canvas Engine
      const refineryCanvas = document.getElementById('refinery-canvas') as HTMLCanvasElement | null;
      if (refineryCanvas) {
        new RefineryCanvasEngine(refineryCanvas, assets);
      }

      // 3b. Mount Section 3 HowItWorks8 & Footer8 Scroll-Reveal Observers
      const hiw8Section = document.getElementById('telemetry');
      if (hiw8Section) {
        const hiwObserver = new IntersectionObserver(
          ([entry]) => {
            if (entry && entry.isIntersecting) {
              hiw8Section.classList.add('is-inview');
              hiwObserver.disconnect();
            }
          },
          { rootMargin: '-80px', threshold: 0.12 }
        );
        hiwObserver.observe(hiw8Section);
      }

      const footer8El = document.getElementById('rb-footer8');
      if (footer8El) {
        const f8Observer = new IntersectionObserver(
          ([entry]) => {
            if (entry && entry.isIntersecting) {
              footer8El.classList.add('is-inview');
              f8Observer.disconnect();
            }
          },
          { threshold: 0.08 }
        );
        f8Observer.observe(footer8El);
      }

      // 4. Mount Section 4 Final CTA Visual Centerpiece, Rising Ink Headline & Sync with Form
      const risingTitleEl = document.getElementById('cta-rising-ink-title') as HTMLElement | null;
      let risingInk: RisingInkEngine | null = null;
      if (risingTitleEl) {
        risingInk = new RisingInkEngine(risingTitleEl, {
          color: '#0b1957',
          colors: ['#93C5FD', '#1129E2'],
          extrusion: 'solid',
          lift: 0.52,
          radius: 1.45,
          view: 'pointer',
          perspective: 1.35,
          stiffness: 1.0,
          damping: 0.5,
          pop: 1.0,
          shadow: 0.6,
          intro: true,
          area: 'parent',
        });
      }

      const swarmCanvas = document.getElementById('mission-swarm-canvas') as HTMLCanvasElement | null;
      const platformBtns = document.querySelectorAll<HTMLButtonElement>('#platform-selectors .cta-plat-pill');
      const platCounter = document.getElementById('lead-plat-counter');
      let swarmEngine: MissionSwarmEngine | null = null;

      const syncPlatformButtons = (selectedList: string[]) => {
        platformBtns.forEach((btn) => {
          const p = btn.getAttribute('data-platform') || '';
          btn.classList.toggle('selected', selectedList.includes(p));
        });
        if (platCounter) {
          platCounter.textContent = `${selectedList.length} / 6 Active`;
          platCounter.classList.remove('pop');
          void platCounter.offsetWidth;
          platCounter.classList.add('pop');
        }
      };

      if (swarmCanvas) {
        swarmEngine = new MissionSwarmEngine(swarmCanvas, assets, (selectedList) => {
          syncPlatformButtons(selectedList);
        });
      }

      platformBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const p = btn.getAttribute('data-platform');
          if (p && swarmEngine) {
            swarmEngine.togglePlatform(p);
          }
          risingInk?.wave();
        });
      });

      // 5. Handle Enterprise Lead Form Motion, Specular Button & Submission -> Telegram & Gmail (/api/lead)
      const leadForm = document.getElementById('enterprise-lead-form') as HTMLFormElement | null;
      const submitBtn = document.getElementById('lead-submit-btn') as HTMLButtonElement | null;
      const submitText = document.getElementById('lead-submit-text');
      const feedbackBanner = document.getElementById('lead-feedback-banner');

      if (submitBtn) {
        new SpecularButtonEngine(submitBtn, {
          radius: 18,
          tint: '#1129e2',
          tintOpacity: 1,
          blur: 0,
          textColor: '#ffffff',
          lineColor: '#bae6fd',
          baseColor: '#1d4ed8',
          intensity: 1.45,
          idleIntensity: 0.55,
          shineSize: 14,
          shineFade: 42,
          thickness: 1.8,
          glow: 1.35,
          speed: 0.35,
          followMouse: true,
          proximity: 280,
          autoAnimate: false,
        });
      }

      if (leadForm) {
        leadForm.addEventListener(
          'pointermove',
          (e) => {
            const rect = leadForm.getBoundingClientRect();
            leadForm.style.setProperty('--spot-x', `${(e.clientX - rect.left).toFixed(1)}px`);
            leadForm.style.setProperty('--spot-y', `${(e.clientY - rect.top).toFixed(1)}px`);
          },
          { passive: true }
        );

        const formObserver = new IntersectionObserver(
          ([entry]) => {
            if (entry && entry.isIntersecting) {
              leadForm.classList.add('is-revealed');
              formObserver.disconnect();
            }
          },
          { threshold: 0.18 }
        );
        formObserver.observe(leadForm);
      }

      leadForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!leadForm || !submitBtn || !feedbackBanner) return;

        const formData = new FormData(leadForm);
        const name = String(formData.get('name') || '').trim();
        const email = String(formData.get('email') || '').trim();
        const telegram = String(formData.get('telegram') || '').trim();
        const warehouse = String(formData.get('warehouse') || 'Snowflake / BigQuery').trim();
        const message = String(formData.get('message') || '').trim();

        const platformsInput = String(formData.get('platforms') || '').trim();
        const platforms = platformsInput
          .split(/[,;\n]/)
          .map((p) => p.trim())
          .filter(Boolean);

        if (!name || !email) {
          feedbackBanner.className = 'cta-feedback-banner show error';
          feedbackBanner.textContent = 'Please enter your Full Name / Company and Work Email.';
          return;
        }

        submitBtn.disabled = true;
        if (submitText) submitText.textContent = 'Dispatching to Telegram & Gmail...';
        feedbackBanner.className = 'cta-feedback-banner';

        try {
          const res = await fetch('/api/lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name,
              email,
              telegram,
              warehouse,
              platforms,
              message,
            }),
          });
          const data = await res.json();

          if (res.ok && data.ok) {
            feedbackBanner.className = 'cta-feedback-banner show success';
            feedbackBanner.textContent =
              '✓ Request sent directly to our Telegram & Gmail! Our data engineering team will reply within 2 hours.';
            leadForm.reset();
          } else {
            throw new Error(data.error || 'Submission failed');
          }
        } catch {
          feedbackBanner.className = 'cta-feedback-banner show error';
          feedbackBanner.textContent =
            'Could not reach server. Please check your connection or email admin@ecommarketdata.com directly.';
        } finally {
          submitBtn.disabled = false;
          if (submitText) submitText.textContent = 'Request Free Sample Dataset';
        }
      });

      // 6. Services Dropdown Menu
      const drop = document.querySelector('.nav-drop') as HTMLElement | null;
      const trigger = drop?.querySelector('.nav-drop-trigger') as HTMLButtonElement | null;
      const setDrop = (open: boolean) => {
        if (!drop || !trigger) return;
        drop.classList.toggle('open', open);
        trigger.setAttribute('aria-expanded', String(open));
      };
      trigger?.addEventListener('click', (event) => {
        event.stopPropagation();
        setDrop(!drop?.classList.contains('open'));
      });
      document.addEventListener('click', (event) => {
        if (drop && !drop.contains(event.target as Node)) setDrop(false);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setDrop(false);
      });
    </script>
  </body>
</html>
