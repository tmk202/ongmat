---
import CabinetPage from '../../layouts/CabinetPage.astro';
import { getCollection, render } from 'astro:content';
import { categoryLabel } from '../../lib/blog-categories';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const siteUrl = (Astro.site ?? new URL('https://ecommarketdata.com')).origin;
const pageUrl = `${siteUrl}/blog/${post.id}/`;
const published = post.data.pubDate.toISOString();
const thumb = post.data.image ?? `/thumbs/${post.id}.webp`;
const thumbUrl = `${siteUrl}${thumb}`;
const modified = (post.data.updatedDate ?? post.data.pubDate).toISOString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${pageUrl}#article`,
    headline: post.data.title,
    description: post.data.description,
    url: pageUrl,
    datePublished: published,
    dateModified: modified,
    inLanguage: 'en-US',
    image: [thumbUrl],
    keywords: post.data.tags.join(', '),
    articleSection: categoryLabel(post.data.category),
    author: { '@type': 'Organization', name: post.data.author, url: `${siteUrl}/` },
    publisher: {
      '@type': 'Organization',
      name: 'ecommarketdata',
      url: `${siteUrl}/`,
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog/` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: pageUrl },
    ],
  },
];

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<CabinetPage
  title={`${post.data.title} — ecommarketdata`}
  description={post.data.description}
  ogImage={thumb}
  ogType="article"
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="container">
      <nav class="crumbs">
        <a href="/">Home</a> / <a href="/blog/">Blog</a> / {post.data.title}
      </nav>

      <article class="prose">
        <img class="post-hero" src={thumb} width="800" height="450" alt={post.data.title} />
        <h1>{post.data.title}</h1>
        <p class="meta">
          <span>
            <time datetime={published}>{formatDate(post.data.pubDate)}</time>
          </span>
          <a class="tag" href={`/blog/category/${post.data.category}/`}>
            {categoryLabel(post.data.category)}
          </a>
        </p>

        <Content />
      </article>

      <p style="margin-top:32px">
        <a href="/blog/">← All notes</a>
      </p>
    </div>
  </section>
</CabinetPage>
