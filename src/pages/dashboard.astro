---
import CabinetPage from '../layouts/CabinetPage.astro';

const siteUrl = (Astro.site ?? new URL('https://ecommarketdata.com')).origin;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ecommarketdata — Marketplace dashboard',
  url: `${siteUrl}/dashboard/`,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  isAccessibleForFree: true,
  description:
    'Query marketplace units sold by platform, industry and month from live telemetry.',
  provider: { '@type': 'Organization', name: 'ecommarketdata', url: `${siteUrl}/` },
};
---

<CabinetPage
  title="Dashboard — ecommarketdata"
  description="Query marketplace units sold by platform, industry and month. Free to use."
  jsonLd={jsonLd}
  wide={true}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Dashboard</p>
      <h1>Marketplace sales query</h1>
      <p class="lede">
        Live marketplace telemetry. Filter by industry or search a product and read units sold
        and estimated revenue for the latest snapshot.
      </p>

      <div class="dash" id="dash">
        <div class="dash-toolbar">
          <div class="dash-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
            <input
              id="f-search"
              type="search"
              placeholder="Search product or brand…"
              autocomplete="off"
              aria-label="Search products"
            />
          </div>

          <label class="dash-field">
            Rank by
            <select id="f-sort">
              <option value="units_sold_month">Units sold / 30 days</option>
              <option value="units_sold_total">Units sold total</option>
              <option value="revenue">Estimated revenue / month</option>
              <option value="price">Price</option>
              <option value="rating">Rating</option>
            </select>
          </label>

          <button class="button button-ghost" id="export" type="button">Export CSV</button>
        </div>

        <div class="dash-pills" id="industry-pills" role="group" aria-label="Industry filter">
          <button class="filter-pill active" type="button" data-cat="all">
            All industries <span>—</span>
          </button>
        </div>

        <div class="bars-panel">
          <div class="dash-chart-head">
            <span>Top products in this list</span>
            <span class="dash-chart-note" id="chart-note"></span>
          </div>
          <div class="bars" id="bars"></div>
        </div>

        <div class="table-wrap">
          <table id="table">
            <thead>
              <tr>
                <th class="rank">#</th>
                <th>Product</th>
                <th>Brand</th>
                <th>Industry</th>
                <th class="num">Units / mo</th>
                <th class="num">Units total</th>
                <th class="num">Est. revenue / mo</th>
                <th class="num">Price</th>
                <th class="num">Rating</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>

        <p class="fine-print" id="status">Loading live data…</p>
      </div>
    </div>
  </section>
</CabinetPage>

<style>
  .bars-panel {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    padding: 16px 18px;
    margin-bottom: 18px;
  }

  .bars {
    display: grid;
    gap: 10px;
    margin-top: 12px;
  }

  .bar-row {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr) minmax(120px, 2fr) 110px;
    gap: 12px;
    align-items: center;
  }

  .bar-rank {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink-50);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .bar-label {
    font-size: 0.8rem;
    color: var(--blue);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bar-track {
    height: 10px;
    border-radius: 999px;
    background: rgba(17, 41, 226, 0.07);
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #1129e2, #4a5cf0);
  }

  .bar-row:nth-child(1) .bar-fill { background: linear-gradient(90deg, #0b1fbf, #1129e2); }
  .bar-row:nth-child(2) .bar-fill { background: linear-gradient(90deg, #2f48e8, #5a6bf2); }
  .bar-row:nth-child(3) .bar-fill { background: linear-gradient(90deg, #4a5cf0, #7d8af6); }

  .bar-val {
    font-size: 0.8rem;
    color: var(--blue);
    font-weight: 600;
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .bar-row { grid-template-columns: 22px minmax(0, 1fr) 96px; }
    .bar-track { display: none; }
  }
</style>

<script>
  type Meta = {
    snapshot_date: string;
    platform: string;
    currency: string | string[];
    categories: string[];
  };
  type CategoryRow = { category_l1: string; items_count: number; units_sold: number };
  type ItemRow = {
    item_id: string;
    title: string;
    brand: string | null;
    category_l1: string | null;
    price: number | null;
    units_sold_month: number;
    units_sold_total: number;
    rating: number | null;
    stock_total: number | null;
    item_url: string;
  };
  type SortKey = 'units_sold_month' | 'units_sold_total' | 'revenue' | 'price' | 'rating';

  const API_BASE =
    location.hostname === 'localhost' || location.hostname === '127.0.0.1'
      ? 'http://127.0.0.1:8102/v1'
      : '/api/v1';

  const $ = <T extends Element>(selector: string) => document.querySelector(selector) as T | null;
  const searchInput = $<HTMLInputElement>('#f-search');
  const sortSelect = $<HTMLSelectElement>('#f-sort');
  const pillsWrap = $('#industry-pills');
  const barsEl = $('#bars');
  const tbody = $<HTMLTableSectionElement>('#table tbody');
  const status = $('#status');
  const chartNote = $('#chart-note');

  const state: { category: string; query: string; sort: SortKey } = {
    category: 'all',
    query: '',
    sort: 'units_sold_month',
  };
  let meta: Meta | null = null;
  let categories: CategoryRow[] = [];
  let items: ItemRow[] = [];

  async function api<T>(path: string): Promise<T> {
    const res = await fetch(`${API_BASE}${path}`, { headers: { Accept: 'application/json' } });
    const body = await res.json();
    if (!res.ok || body.ok === false) {
      throw new Error(body?.error?.message || `Request failed (${res.status})`);
    }
    return body as T;
  }

  const fmtInt = new Intl.NumberFormat('en-SG');
  const fmtCompact = new Intl.NumberFormat('en-SG', { notation: 'compact', maximumFractionDigits: 1 });
  const fmtPrice = (value: number | null) => {
    if (value === null || value === undefined) return '—';
    const currency = Array.isArray(meta?.currency) ? meta?.currency[0] : meta?.currency;
    try {
      return new Intl.NumberFormat('en-SG', {
        style: 'currency',
        currency: currency || 'VND',
        maximumFractionDigits: 0,
      }).format(value);
    } catch {
      return fmtInt.format(Math.round(value));
    }
  };
  const escapeHtml = (value: string) =>
    String(value).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);

  const revenue = (row: ItemRow) => (Number(row.units_sold_month) || 0) * (Number(row.price) || 0);

  const METRICS: Record<SortKey, { label: string; value: (row: ItemRow) => number; format: (v: number) => string }> = {
    units_sold_month: {
      label: 'Units sold / 30 days',
      value: (row) => Number(row.units_sold_month) || 0,
      format: (v) => fmtInt.format(Math.round(v)),
    },
    units_sold_total: {
      label: 'Units sold total',
      value: (row) => Number(row.units_sold_total) || 0,
      format: (v) => fmtInt.format(Math.round(v)),
    },
    revenue: {
      label: 'Est. revenue / month',
      value: revenue,
      format: (v) => fmtPrice(v),
    },
    price: {
      label: 'Price',
      value: (row) => Number(row.price) || 0,
      format: (v) => fmtPrice(v),
    },
    rating: {
      label: 'Rating',
      value: (row) => Number(row.rating) || 0,
      format: (v) => v.toFixed(2),
    },
  };

  function renderPills() {
    if (!pillsWrap) return;
    const total = categories.reduce((sum, c) => sum + Number(c.units_sold), 0);
    pillsWrap.innerHTML = `
      <button class="filter-pill ${state.category === 'all' ? 'active' : ''}" type="button" data-cat="all">
        All industries <span>${fmtCompact.format(total)}</span>
      </button>
      ${categories
        .map(
          (c) => `<button class="filter-pill ${state.category === c.category_l1 ? 'active' : ''}" type="button" data-cat="${escapeHtml(c.category_l1)}">
            ${escapeHtml(c.category_l1)} <span>${fmtCompact.format(Number(c.units_sold))}</span>
          </button>`
        )
        .join('')}`;
    pillsWrap.querySelectorAll<HTMLButtonElement>('.filter-pill').forEach((pill) => {
      pill.addEventListener('click', () => {
        state.category = pill.dataset.cat || 'all';
        renderPills();
        loadItems();
      });
    });
  }

  function renderBars() {
    if (!barsEl) return;
    const metric = METRICS[state.sort];
    const top = items.slice(0, 8);
    const max = Math.max(...top.map(metric.value), 1);
    barsEl.innerHTML = top
      .map(
        (item, index) => `<div class="bar-row">
          <span class="bar-rank">${index + 1}</span>
          <span class="bar-label" title="${escapeHtml(item.title || '')}">${escapeHtml(item.title || 'Untitled')}</span>
          <span class="bar-track"><span class="bar-fill" style="display:block;width:${Math.max(4, (metric.value(item) / max) * 100).toFixed(1)}%"></span></span>
          <span class="bar-val">${metric.format(metric.value(item))}</span>
        </div>`
      )
      .join('');
    if (chartNote) {
      chartNote.textContent = `${metric.label} · snapshot ${meta?.snapshot_date ?? ''}`;
    }
  }

  function renderTable() {
    if (!tbody) return;
    tbody.innerHTML = items
      .map(
        (item, index) => `
      <tr>
        <td class="rank">${index + 1}</td>
        <td class="strong"><a href="${escapeHtml(item.item_url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(item.title || 'Untitled')}</a></td>
        <td>${escapeHtml(item.brand || '—')}</td>
        <td>${escapeHtml(item.category_l1 || '—')}</td>
        <td class="num strong">${fmtInt.format(item.units_sold_month ?? 0)}</td>
        <td class="num dim">${fmtInt.format(item.units_sold_total ?? 0)}</td>
        <td class="num dim">${fmtPrice(revenue(item))}</td>
        <td class="num dim">${fmtPrice(item.price)}</td>
        <td class="num dim">${item.rating ? item.rating.toFixed(2) : '—'}</td>
      </tr>`
      )
      .join('');
  }

  function sortByRevenue(rows: ItemRow[]): ItemRow[] {
    return [...rows].sort((a, b) => revenue(b) - revenue(a));
  }

  async function loadItems() {
    const build = (sortKey: string) => {
      const params = new URLSearchParams({ limit: '100', sort: sortKey, order: 'desc' });
      if (state.category !== 'all') params.set('category', state.category);
      if (state.query.trim()) params.set('q', state.query.trim());
      return params;
    };
    try {
      let data: { rows: ItemRow[]; meta?: Meta };
      let clientSorted = false;
      try {
        data = await api<{ rows: ItemRow[]; meta?: Meta }>(`/items?${build(state.sort)}`);
      } catch (error) {
        if (state.sort !== 'revenue') throw error;
        data = await api<{ rows: ItemRow[]; meta?: Meta }>(`/items?${build('units_sold_month')}`);
        clientSorted = true;
      }
      items = clientSorted ? sortByRevenue(data.rows) : data.rows;
      if (data.meta) meta = { ...(meta as Meta), ...data.meta };
      renderBars();
      renderTable();
      if (status) {
        const cat = state.category === 'all' ? 'all industries' : state.category;
        status.textContent = `Shopee · ${cat}${state.query ? ` · “${state.query}”` : ''} · ${items.length} products · snapshot ${meta?.snapshot_date ?? ''}`;
      }
    } catch (error) {
      if (status) status.textContent = `Could not load products: ${(error as Error).message}`;
    }
  }

  async function boot() {
    try {
      const metaRes = await api<{ meta: Meta }>('/meta');
      meta = metaRes.meta;
      const catRes = await api<{ rows: CategoryRow[] }>('/categories');
      categories = catRes.rows;
      renderPills();
      await loadItems();
    } catch (error) {
      if (status) status.textContent = `Backend unavailable: ${(error as Error).message}`;
    }
  }

  let searchTimer: number | undefined;
  searchInput?.addEventListener('input', () => {
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => {
      state.query = searchInput.value;
      loadItems();
    }, 220);
  });

  sortSelect?.addEventListener('change', () => {
    state.sort = sortSelect.value as SortKey;
    loadItems();
  });

  $<HTMLButtonElement>('#export')?.addEventListener('click', () => {
    const header = 'rank,item_id,title,brand,category,price,units_sold_month,revenue_month,units_sold_total,rating,url';
    const lines = items.map((i, idx) =>
      [
        idx + 1,
        i.item_id,
        `"${String(i.title || '').replace(/"/g, '""')}"`,
        `"${String(i.brand || '').replace(/"/g, '""')}"`,
        i.category_l1 || '',
        i.price ?? '',
        i.units_sold_month ?? 0,
        Math.round(revenue(i)),
        i.units_sold_total ?? 0,
        i.rating ?? '',
        i.item_url,
      ].join(',')
    );
    const blob = new Blob([[header, ...lines].join('\n')], { type: 'text/csv;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'ecommarketdata-items.csv';
    a.click();
    URL.revokeObjectURL(url);
  });

  const params = new URLSearchParams(location.search);
  if (params.get('industry')) state.category = params.get('industry') as string;
  if (params.get('q')) {
    state.query = params.get('q') as string;
    if (searchInput) searchInput.value = state.query;
  }

  boot();
</script>
