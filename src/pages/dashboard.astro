---
import CabinetPage from '../layouts/CabinetPage.astro';

const siteUrl = (Astro.site ?? new URL('https://ecommarketdata.com')).origin;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ecommarketdata — Marketplace dashboard',
  url: `${siteUrl}/dashboard/`,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  isAccessibleForFree: true,
  description:
    'Query marketplace units sold by platform, industry and month from live telemetry.',
  provider: { '@type': 'Organization', name: 'ecommarketdata', url: `${siteUrl}/` },
};
---

<CabinetPage
  title="Dashboard — ecommarketdata"
  description="Query marketplace units sold by platform, industry and month. Free to use."
  jsonLd={jsonLd}
  wide={true}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Dashboard</p>
      <h1>Marketplace sales query</h1>
      <p class="lede">
        Live marketplace telemetry. Filter by industry or search a product and read units sold,
        price and stock for the latest snapshot.
      </p>

      <div class="dash" id="dash">
        <div class="dash-toolbar">
          <div class="dash-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
            <input
              id="f-search"
              type="search"
              placeholder="Search product or brand…"
              autocomplete="off"
              aria-label="Search products"
            />
          </div>

          <label class="dash-field">
            Platform
            <select id="f-platform">
              <option value="shopee">Shopee</option>
            </select>
          </label>

          <button class="button button-ghost" id="export" type="button">Export CSV</button>
        </div>

        <div class="dash-pills" id="industry-pills" role="group" aria-label="Industry filter">
          <button class="filter-pill active" type="button" data-cat="all">
            All industries <span>—</span>
          </button>
        </div>

        <div class="dash-chart">
          <div class="dash-chart-head">
            <span id="chart-title">Units sold by month</span>
            <div class="chart-legend" id="chart-legend"></div>
            <span class="dash-chart-note" id="chart-note"></span>
          </div>
          <div class="chart-plot">
            <svg id="chart" viewBox="0 0 900 260" role="img" aria-label="Monthly units sold by industry"></svg>
            <div class="chart-tip" id="chart-tip" hidden></div>
          </div>
        </div>

        <div class="table-wrap">
          <table id="table">
            <thead>
              <tr>
                <th class="rank">#</th>
                <th>Product</th>
                <th>Brand</th>
                <th>Industry</th>
                <th class="num">Units / mo</th>
                <th class="num">Units total</th>
                <th class="num">Price</th>
                <th class="num">Rating</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>

        <p class="fine-print" id="status">Loading live data…</p>
      </div>
    </div>
  </section>
</CabinetPage>

<script>
  type Meta = {
    snapshot_date: string;
    last_updated: string | null;
    platform: string;
    currency: string | string[];
    categories: string[];
    totals?: { items_count: number; units_sold: number; gmv_est: number } | null;
  };
  type CategoryRow = { category_l1: string; items_count: number; units_sold: number };
  type MetricRow = {
    period: string;
    category_l1: string;
    units_sold: number;
    gmv_est: number;
    items_count: number;
    price_index?: number;
  };
  type ItemRow = {
    item_id: string;
    shop_id: string;
    title: string;
    brand: string | null;
    category_l1: string | null;
    price: number | null;
    units_sold_month: number;
    units_sold_total: number;
    rating: number | null;
    stock_total: number | null;
    item_url: string;
    snapshot_date: string;
  };

  const API_BASE =
    location.hostname === 'localhost' || location.hostname === '127.0.0.1'
      ? 'http://127.0.0.1:8102/v1'
      : '/api/v1';

  const PALETTE = ['#1129e2', '#0aa5c6', '#d946a8', '#7c3aed', '#f59e0b', '#059669', '#dc2626', '#0891b2', '#9333ea'];

  const $ = <T extends Element>(selector: string) => document.querySelector(selector) as T | null;
  const searchInput = $<HTMLInputElement>('#f-search');
  const pillsWrap = $('#industry-pills');
  const chart = $<SVGSVGElement>('#chart');
  const tbody = $<HTMLTableSectionElement>('#table tbody');
  const status = $('#status');
  const chartNote = $('#chart-note');
  const tips = $('#chart-tip');
  const plot = document.querySelector('.chart-plot') as HTMLElement | null;
  const tip = document.querySelector('#chart-tip') as HTMLElement | null;

  const state = { category: 'all', query: '' };
  let meta: Meta | null = null;
  let categories: CategoryRow[] = [];
  let monthTotals: MetricRow[] = [];
  let series: { name: string; values: number[] }[] = [];
  let months: string[] = [];
  let items: ItemRow[] = [];

  async function api<T>(path: string): Promise<T> {
    const res = await fetch(`${API_BASE}${path}`, { headers: { Accept: 'application/json' } });
    const body = await res.json();
    if (!res.ok || body.ok === false) {
      throw new Error(body?.error?.message || `Request failed (${res.status})`);
    }
    return body as T;
  }

  const fmtInt = new Intl.NumberFormat('en-SG');
  const fmtCompact = new Intl.NumberFormat('en-SG', { notation: 'compact', maximumFractionDigits: 1 });
  const fmtPrice = (value: number | null) => {
    if (value === null || value === undefined) return '—';
    const currency = Array.isArray(meta?.currency) ? meta?.currency[0] : meta?.currency;
    try {
      return new Intl.NumberFormat('en-SG', {
        style: 'currency',
        currency: currency || 'VND',
        maximumFractionDigits: 0,
      }).format(value);
    } catch {
      return fmtInt.format(Math.round(value));
    }
  };
  const fmtMonth = (period: string) => {
    const d = new Date(period);
    return d.toLocaleDateString('en-SG', { month: 'short', year: 'numeric' });
  };
  const escapeHtml = (value: string) =>
    String(value).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);

  function renderPills() {
    if (!pillsWrap) return;
    const total = categories.reduce((sum, c) => sum + Number(c.units_sold), 0);
    pillsWrap.innerHTML = `
      <button class="filter-pill ${state.category === 'all' ? 'active' : ''}" type="button" data-cat="all">
        All industries <span>${fmtCompact.format(total)}</span>
      </button>
      ${categories
        .map(
          (c) => `<button class="filter-pill ${state.category === c.category_l1 ? 'active' : ''}" type="button" data-cat="${escapeHtml(c.category_l1)}">
            ${escapeHtml(c.category_l1)} <span>${fmtCompact.format(Number(c.units_sold))}</span>
          </button>`
        )
        .join('')}`;
    pillsWrap.querySelectorAll<HTMLButtonElement>('.filter-pill').forEach((pill) => {
      pill.addEventListener('click', () => {
        state.category = pill.dataset.cat || 'all';
        renderPills();
        loadItems();
        loadChart();
      });
    });
  }

  function smoothPath(points: { x: number; y: number }[]): string {
    if (points.length === 0) return '';
    if (points.length === 1) return `M ${points[0].x} ${points[0].y}`;
    let d = `M ${points[0].x.toFixed(1)} ${points[0].y.toFixed(1)}`;
    for (let i = 0; i < points.length - 1; i++) {
      const p0 = points[i - 1] ?? points[i];
      const p1 = points[i];
      const p2 = points[i + 1];
      const p3 = points[i + 2] ?? p2;
      const c1x = p1.x + (p2.x - p0.x) / 6;
      const c1y = p1.y + (p2.y - p0.y) / 6;
      const c2x = p2.x - (p3.x - p1.x) / 6;
      const c2y = p2.y - (p3.y - p1.y) / 6;
      d += ` C ${c1x.toFixed(1)} ${c1y.toFixed(1)}, ${c2x.toFixed(1)} ${c2y.toFixed(1)}, ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`;
    }
    return d;
  }

  function niceCeil(value: number): number {
    const pow = Math.pow(10, Math.floor(Math.log10(value || 1)));
    const n = value / pow;
    const step = n <= 1 ? 1 : n <= 2 ? 2 : n <= 5 ? 5 : 10;
    return step * pow;
  }

  type Geom = {
    months: string[];
    series: { name: string; values: number[] }[];
    xAt: (i: number) => number;
    yAt: (v: number) => number;
    padLeft: number;
    innerW: number;
    innerH: number;
    h: number;
  };
  let geom: Geom | null = null;

  function renderChart() {
    if (!chart) return;
    const legend = document.querySelector('#chart-legend');
    if (!months.length) {
      chart.innerHTML = '';
      if (legend) legend.innerHTML = '';
      if (tip) tip.hidden = true;
      geom = null;
      return;
    }

    const w = Math.max(chart.clientWidth, 320);
    const h = Math.max(chart.clientHeight, 180);
    chart.setAttribute('viewBox', `0 0 ${w} ${h}`);

    const padLeft = 56;
    const padRight = 14;
    const padTop = 14;
    const padBottom = 30;
    const innerW = w - padLeft - padRight;
    const innerH = h - padTop - padBottom;

    const rawMax = Math.max(...series.flatMap((s) => s.values), 1);
    const max = niceCeil(rawMax);

    const xAt = (i: number) => (months.length === 1 ? padLeft + innerW / 2 : padLeft + (innerW * i) / (months.length - 1));
    const yAt = (v: number) => padTop + innerH * (1 - v / max);
    geom = { months, series, xAt, yAt, padLeft, innerW, innerH, h };

    const tickValues = [0, 0.25, 0.5, 0.75, 1].map((r) => max * r);
    const grid = tickValues
      .map((value) => {
        const y = yAt(value);
        return `<line x1="${padLeft}" y1="${y.toFixed(1)}" x2="${w - padRight}" y2="${y.toFixed(1)}" stroke="rgba(17,41,226,0.08)" stroke-width="1" />
          <text x="${padLeft - 10}" y="${(y + 3.5).toFixed(1)}" text-anchor="end" font-size="10.5" fill="rgba(17,41,226,0.42)">${fmtCompact.format(value)}</text>`;
      })
      .join('');

    const slot = months.length > 1 ? innerW / (months.length - 1) : innerW;
    const step = Math.max(1, Math.ceil(52 / slot));
    const labels = months
      .map((month, i) => {
        if (i % step !== 0 && i !== months.length - 1) return '';
        return `<text x="${xAt(i).toFixed(1)}" y="${h - 8}" text-anchor="middle" font-size="11" fill="rgba(17,41,226,0.45)">${fmtMonth(month).split(' ')[0]}</text>`;
      })
      .join('');

    const lines = series
      .map((item, index) => {
        const color = PALETTE[index % PALETTE.length];
        if (item.values.length === 1) {
          return `<circle cx="${xAt(0).toFixed(1)}" cy="${yAt(item.values[0]).toFixed(1)}" r="4.5" fill="${color}" stroke="#fff" stroke-width="2" />`;
        }
        const points = item.values.map((value, i) => ({ x: xAt(i), y: yAt(value) }));
        return `<path d="${smoothPath(points)}" fill="none" stroke="${color}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />`;
      })
      .join('');

    chart.innerHTML = `
      <g>${grid}</g>
      <g>${lines}</g>
      <line id="chart-guide" x1="0" y1="${padTop}" x2="0" y2="${h - padBottom}" stroke="rgba(17,41,226,0.32)" stroke-width="1" stroke-dasharray="3 3" opacity="0" />
      <g id="chart-dots"></g>
      <g>${labels}</g>
      <rect id="chart-hit" x="${padLeft}" y="${padTop}" width="${innerW}" height="${innerH}" fill="transparent" pointer-events="all" />
    `;

    if (legend) {
      legend.innerHTML = series
        .map((item, index) => `<span class="chart-key"><i style="background:${PALETTE[index % PALETTE.length]}"></i>${escapeHtml(item.name)}</span>`)
        .join('');
    }
  }

  function clearHover() {
    document.querySelector('#chart-guide')?.setAttribute('opacity', '0');
    const dots = document.querySelector('#chart-dots');
    if (dots) dots.innerHTML = '';
    if (tip) tip.hidden = true;
  }

  function handleHover(event: PointerEvent) {
    if (!geom || !chart || !tip || !plot) return;
    const rect = chart.getBoundingClientRect();
    const ratio = (event.clientX - rect.left - geom.padLeft) / geom.innerW;
    const index = Math.max(0, Math.min(geom.months.length - 1, Math.round(ratio * (geom.months.length - 1))));
    const gx = geom.xAt(index);
    const guide = document.querySelector('#chart-guide');
    if (guide) {
      guide.setAttribute('x1', String(gx));
      guide.setAttribute('x2', String(gx));
      guide.setAttribute('opacity', '1');
    }
    const dots = document.querySelector('#chart-dots');
    if (dots) {
      dots.innerHTML = geom.series
        .map((s, i) => `<circle cx="${gx.toFixed(1)}" cy="${geom!.yAt(s.values[index] ?? 0).toFixed(1)}" r="3.6" fill="${PALETTE[i % PALETTE.length]}" stroke="#fff" stroke-width="1.6" />`)
        .join('');
    }
    tip.innerHTML = `
      <div class="chart-tip-head">${fmtMonth(geom.months[index])}</div>
      ${geom.series
        .map((s, i) => `<div class="chart-tip-row"><i style="background:${PALETTE[i % PALETTE.length]}"></i><span class="name">${escapeHtml(s.name)}</span><span class="val">${fmtInt.format(Math.round(s.values[index] ?? 0))}</span></div>`)
        .join('')}
      <div class="chart-tip-unit">units sold</div>`;
    tip.hidden = false;
    const plotRect = plot.getBoundingClientRect();
    const tipW = tip.offsetWidth;
    const tipH = tip.offsetHeight;
    let left = event.clientX - plotRect.left + 16;
    let top = event.clientY - plotRect.top - tipH / 2;
    if (left + tipW > plotRect.width - 8) left = event.clientX - plotRect.left - tipW - 16;
    if (left < 8) left = 8;
    top = Math.max(8, Math.min(top, plotRect.height - tipH - 8));
    tip.style.left = `${left}px`;
    tip.style.top = `${top}px`;
  }

  chart?.addEventListener('pointermove', handleHover);
  chart?.addEventListener('pointerleave', clearHover);

  function renderTable() {
    if (!tbody) return;
    tbody.innerHTML = items
      .map(
        (item, index) => `
      <tr>
        <td class="rank">${index + 1}</td>
        <td class="strong"><a href="${escapeHtml(item.item_url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(item.title || 'Untitled')}</a></td>
        <td>${escapeHtml(item.brand || '—')}</td>
        <td>${escapeHtml(item.category_l1 || '—')}</td>
        <td class="num strong">${fmtInt.format(item.units_sold_month ?? 0)}</td>
        <td class="num dim">${fmtInt.format(item.units_sold_total ?? 0)}</td>
        <td class="num dim">${fmtPrice(item.price)}</td>
        <td class="num dim">${item.rating ? item.rating.toFixed(2) : '—'}</td>
      </tr>`
      )
      .join('');
  }

  async function loadItems() {
    const params = new URLSearchParams({ limit: '100', sort: 'units_sold_month', order: 'desc' });
    if (state.category !== 'all') params.set('category', state.category);
    if (state.query.trim()) params.set('q', state.query.trim());
    try {
      const data = await api<{ rows: ItemRow[]; meta?: Meta }>(`/items?${params}`);
      items = data.rows;
      if (data.meta) meta = data.meta;
      renderTable();
      if (status) {
        const cat = state.category === 'all' ? 'all industries' : state.category;
        status.textContent = `Shopee · ${cat}${state.query ? ` · “${state.query}”` : ''} · ${items.length} products · snapshot ${meta?.snapshot_date ?? ''}`;
      }
    } catch (error) {
      if (status) status.textContent = `Could not load products: ${(error as Error).message}`;
    }
  }

  async function loadChart() {
    try {
      const targets = state.category === 'all' ? categories.map((c) => c.category_l1) : [state.category];
      const results = await Promise.all(
        targets.map((cat) => api<{ rows: MetricRow[] }>(`/metrics?granularity=month&category=${encodeURIComponent(cat)}`))
      );
      const monthSet = new Set<string>();
      results.forEach((r) => r.rows.forEach((row) => monthSet.add(row.period)));
      months = [...monthSet].sort();
      series = targets.map((cat, i) => {
        const map = new Map(results[i].rows.map((row) => [row.period, Number(row.units_sold)]));
        return { name: cat, values: months.map((m) => map.get(m) ?? 0) };
      });
      if (chartNote) {
        chartNote.textContent = months.length
          ? `${fmtMonth(months[0])} – ${fmtMonth(months[months.length - 1])}`
          : 'No history yet';
      }
      renderChart();
    } catch (error) {
      if (status) status.textContent = `Could not load chart: ${(error as Error).message}`;
    }
  }

  async function boot() {
    try {
      const metaRes = await api<{ meta: Meta }>('/meta');
      meta = metaRes.meta;
      const catRes = await api<{ rows: CategoryRow[] }>('/categories');
      categories = catRes.rows;
      renderPills();
      await Promise.all([loadChart(), loadItems()]);
    } catch (error) {
      if (status) status.textContent = `Backend unavailable: ${(error as Error).message}`;
    }
  }

  let searchTimer: number | undefined;
  searchInput?.addEventListener('input', () => {
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => {
      state.query = searchInput.value;
      loadItems();
    }, 220);
  });

  $<HTMLButtonElement>('#export')?.addEventListener('click', () => {
    const header = 'item_id,title,brand,category,price,units_sold_month,units_sold_total,rating,url';
    const lines = items.map((i) =>
      [
        i.item_id,
        `"${String(i.title || '').replace(/"/g, '""')}"`,
        `"${String(i.brand || '').replace(/"/g, '""')}"`,
        i.category_l1 || '',
        i.price ?? '',
        i.units_sold_month ?? 0,
        i.units_sold_total ?? 0,
        i.rating ?? '',
        i.item_url,
      ].join(',')
    );
    const blob = new Blob([[header, ...lines].join('\n')], { type: 'text/csv;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'ecommarketdata-items.csv';
    a.click();
    URL.revokeObjectURL(url);
  });

  let resizeTimer: number | undefined;
  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => renderChart(), 150);
  });

  const params = new URLSearchParams(location.search);
  if (params.get('industry')) state.category = params.get('industry') as string;
  if (params.get('q')) {
    state.query = params.get('q') as string;
    if (searchInput) searchInput.value = state.query;
  }

  boot();
</script>
