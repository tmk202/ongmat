---
import CabinetPage from '../layouts/CabinetPage.astro';

const siteUrl = (Astro.site ?? new URL('https://ecommarketdata.com')).origin;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ecommarketdata — Marketplace dashboard',
  url: `${siteUrl}/dashboard/`,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  isAccessibleForFree: true,
  description:
    'Query marketplace units sold by platform, industry and month from live telemetry.',
  provider: { '@type': 'Organization', name: 'ecommarketdata', url: `${siteUrl}/` },
};
---

<CabinetPage
  title="Dashboard — ecommarketdata"
  description="Query marketplace units sold by platform, industry and month. Free to use."
  jsonLd={jsonLd}
  wide={true}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Dashboard</p>
      <h1>Marketplace sales query</h1>
      <p class="lede">
        Live marketplace telemetry. Filter by industry or search a product and read units sold
        and estimated revenue for the latest snapshot.
      </p>

      <div class="dash" id="dash">
        <div class="dash-toolbar">
          <div class="dash-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
            <input
              id="f-search"
              type="search"
              placeholder="Search product or brand…"
              autocomplete="off"
              aria-label="Search products"
            />
          </div>

          <label class="dash-field">
            Rank by
            <select id="f-sort">
              <option value="units_sold_month">Units sold / 30 days</option>
              <option value="units_sold_total">Units sold total</option>
              <option value="revenue">Estimated revenue / month</option>
              <option value="price">Price</option>
              <option value="rating">Rating</option>
            </select>
          </label>

          <button class="button button-ghost" id="export" type="button">Export CSV</button>
        </div>

        <div class="dash-pills" id="industry-pills" role="group" aria-label="Industry filter">
          <button class="filter-pill active" type="button" data-cat="all">
            All industries <span>—</span>
          </button>
        </div>

        <div class="bars-panel">
          <div class="dash-chart-head">
            <span id="chart-title">Top products in this list</span>
            <button type="button" class="chart-back" id="chart-back" hidden>← Back to list</button>
            <span class="dash-chart-note" id="chart-note"></span>
          </div>
          <div class="bars" id="bars"></div>
        </div>

        <div class="table-wrap">
          <table id="table">
            <thead>
              <tr>
                <th class="rank">#</th>
                <th>Product</th>
                <th>Brand</th>
                <th>Industry</th>
                <th class="num">Units / mo</th>
                <th class="num">Units total</th>
                <th class="num">Est. revenue / mo</th>
                <th class="num">Price</th>
                <th class="num">Rating</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>

        <p class="fine-print" id="status">Loading live data…</p>
      </div>
    </div>
  </section>
</CabinetPage>

<style is:global>
  .bars-panel {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    padding: 16px 18px;
    margin-bottom: 18px;
  }

  .bars {
    display: grid;
    gap: 10px;
    margin-top: 12px;
  }

  .bar-row {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr) minmax(120px, 2fr) 110px;
    gap: 12px;
    align-items: center;
  }

  .bar-rank {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink-50);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .bar-label {
    font-size: 0.8rem;
    color: var(--blue);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bar-track {
    height: 10px;
    border-radius: 999px;
    background: rgba(17, 41, 226, 0.07);
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #1129e2, #4a5cf0);
  }

  .chart-back {
    font: inherit;
    font-size: 0.76rem;
    color: var(--blue);
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 10px;
    cursor: pointer;
    margin-left: 10px;
  }

  .chart-back:hover { border-color: var(--blue); }

  .prod-name { display: inline; }
  .prod-link {
    display: inline-flex;
    vertical-align: -3px;
    margin-left: 6px;
    width: 18px;
    height: 18px;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    color: var(--ink-50);
    border: 1px solid transparent;
  }
  .prod-link svg { width: 13px; height: 13px; }
  .prod-link:hover {
    color: var(--blue);
    border-color: var(--line);
    background: rgba(17, 41, 226, 0.05);
  }

  #table tbody tr { cursor: pointer; }
  #table tbody tr.is-selected { background: rgba(17, 41, 226, 0.06); }

  .bar-row { cursor: pointer; }
  .bar-row:hover .bar-label { text-decoration: underline; }

  .bar-row:nth-child(1) .bar-fill { background: linear-gradient(90deg, #0b1fbf, #1129e2); }
  .bar-row:nth-child(2) .bar-fill { background: linear-gradient(90deg, #2f48e8, #5a6bf2); }
  .bar-row:nth-child(3) .bar-fill { background: linear-gradient(90deg, #4a5cf0, #7d8af6); }

  .bar-val {
    font-size: 0.8rem;
    color: var(--blue);
    font-weight: 600;
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .bar-row { grid-template-columns: 22px minmax(0, 1fr) 96px; }
    .bar-track { display: none; }
  }
</style>

<script>
  type Meta = {
    snapshot_date: string;
    platform: string;
    currency: string | string[];
    categories: string[];
  };
  type CategoryRow = { category_l1: string; items_count: number; units_sold: number };
  type ItemRow = {
    item_id: string;
    title: string;
    brand: string | null;
    category_l1: string | null;
    price: number | null;
    units_sold_month: number;
    units_sold_total: number;
    rating: number | null;
    stock_total: number | null;
    item_url: string;
  };
  type SortKey = 'units_sold_month' | 'units_sold_total' | 'revenue' | 'price' | 'rating';

  const API_BASE =
    location.hostname === 'localhost' || location.hostname === '127.0.0.1'
      ? 'http://127.0.0.1:8102/v1'
      : '/api/v1';

  const $ = <T extends Element>(selector: string) => document.querySelector(selector) as T | null;
  const searchInput = $<HTMLInputElement>('#f-search');
  const sortSelect = $<HTMLSelectElement>('#f-sort');
  const pillsWrap = $('#industry-pills');
  const barsEl = $('#bars');
  const tbody = $<HTMLTableSectionElement>('#table tbody');
  const status = $('#status');
  const chartNote = $('#chart-note');
  const chartTitle = $('#chart-title');
  const chartBack = $<HTMLButtonElement>('#chart-back');

  type HistoryPoint = { date: string; units_sold_month: number; units_sold_total: number; price: number | null; rating: number | null };

  const state: { category: string; query: string; sort: SortKey; selected: ItemRow | null; history: HistoryPoint[] } = {
    category: 'all',
    query: '',
    sort: 'units_sold_month',
    selected: null,
    history: [],
  };
  let meta: Meta | null = null;
  let categories: CategoryRow[] = [];
  let items: ItemRow[] = [];

  async function api<T>(path: string): Promise<T> {
    const res = await fetch(`${API_BASE}${path}`, { headers: { Accept: 'application/json' } });
    const body = await res.json();
    if (!res.ok || body.ok === false) {
      throw new Error(body?.error?.message || `Request failed (${res.status})`);
    }
    return body as T;
  }

  const fmtInt = new Intl.NumberFormat('en-SG');
  const fmtCompact = new Intl.NumberFormat('en-SG', { notation: 'compact', maximumFractionDigits: 1 });
  const fmtPrice = (value: number | null) => {
    if (value === null || value === undefined) return '—';
    const currency = Array.isArray(meta?.currency) ? meta?.currency[0] : meta?.currency;
    try {
      return new Intl.NumberFormat('en-SG', {
        style: 'currency',
        currency: currency || 'VND',
        maximumFractionDigits: 0,
      }).format(value);
    } catch {
      return fmtInt.format(Math.round(value));
    }
  };
  const escapeHtml = (value: string) =>
    String(value).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);

  const revenue = (row: ItemRow) => (Number(row.units_sold_month) || 0) * (Number(row.price) || 0);

  const METRICS: Record<SortKey, { label: string; value: (row: ItemRow) => number; format: (v: number) => string }> = {
    units_sold_month: {
      label: 'Units sold / 30 days',
      value: (row) => Number(row.units_sold_month) || 0,
      format: (v) => fmtInt.format(Math.round(v)),
    },
    units_sold_total: {
      label: 'Units sold total',
      value: (row) => Number(row.units_sold_total) || 0,
      format: (v) => fmtInt.format(Math.round(v)),
    },
    revenue: {
      label: 'Est. revenue / month',
      value: revenue,
      format: (v) => fmtPrice(v),
    },
    price: {
      label: 'Price',
      value: (row) => Number(row.price) || 0,
      format: (v) => fmtPrice(v),
    },
    rating: {
      label: 'Rating',
      value: (row) => Number(row.rating) || 0,
      format: (v) => v.toFixed(2),
    },
  };

  function renderPills() {
    if (!pillsWrap) return;
    const total = categories.reduce((sum, c) => sum + Number(c.units_sold), 0);
    pillsWrap.innerHTML = `
      <button class="filter-pill ${state.category === 'all' ? 'active' : ''}" type="button" data-cat="all">
        All industries <span>${fmtCompact.format(total)}</span>
      </button>
      ${categories
        .map(
          (c) => `<button class="filter-pill ${state.category === c.category_l1 ? 'active' : ''}" type="button" data-cat="${escapeHtml(c.category_l1)}">
            ${escapeHtml(c.category_l1)} <span>${fmtCompact.format(Number(c.units_sold))}</span>
          </button>`
        )
        .join('')}`;
    pillsWrap.querySelectorAll<HTMLButtonElement>('.filter-pill').forEach((pill) => {
      pill.addEventListener('click', () => {
        state.category = pill.dataset.cat || 'all';
        renderPills();
        loadItems();
      });
    });
  }

  function niceCeil(value: number): number {
    const pow = Math.pow(10, Math.floor(Math.log10(value || 1)));
    const n = value / pow;
    const step = n <= 1 ? 1 : n <= 2 ? 2 : n <= 5 ? 5 : 10;
    return step * pow;
  }

  const fmtDate = (iso: string) => {
    const d = new Date(iso);
    return d.toLocaleDateString('en-SG', { day: 'numeric', month: 'short' });
  };

  function renderHistory() {
    const item = state.selected;
    if (!barsEl || !item) return;
    const points = state.history;
    if (!points.length) {
      barsEl.innerHTML = '<p class="fine-print">No history for this product yet. It will appear after the next snapshot.</p>';
      return;
    }
    const w = Math.max(barsEl.clientWidth, 320);
    const h = 220;
    const padL = 52;
    const padR = 14;
    const padT = 14;
    const padB = 26;
    const values = points.map((p) => Number(p.units_sold_month) || 0);
    const max = niceCeil(Math.max(...values, 1));
    const xAt = (i: number) => (points.length === 1 ? padL + (w - padL - padR) / 2 : padL + ((w - padL - padR) * i) / (points.length - 1));
    const yAt = (v: number) => padT + (h - padT - padB) * (1 - v / max);
    const grid = [0, 0.5, 1]
      .map((r) => {
        const v = max * r;
        const y = yAt(v);
        return `<line x1="${padL}" y1="${y}" x2="${w - padR}" y2="${y}" stroke="rgba(17,41,226,0.08)" />
          <text x="${padL - 8}" y="${y + 3.5}" text-anchor="end" font-size="10" fill="rgba(17,41,226,0.45)">${fmtCompact.format(v)}</text>`;
      })
      .join('');
    const path = values.map((v, i) => `${i === 0 ? 'M' : 'L'} ${xAt(i).toFixed(1)} ${yAt(v).toFixed(1)}`).join(' ');
    const dots = values
      .map((v, i) => `<circle cx="${xAt(i).toFixed(1)}" cy="${yAt(v).toFixed(1)}" r="4" fill="#1129e2" stroke="#fff" stroke-width="2" />`)
      .join('');
    const labels = points
      .map((p, i) => {
        const step = Math.max(1, Math.ceil(points.length / 6));
        if (i % step !== 0 && i !== points.length - 1) return '';
        return `<text x="${xAt(i).toFixed(1)}" y="${h - 8}" text-anchor="middle" font-size="10.5" fill="rgba(17,41,226,0.5)">${fmtDate(p.date)}</text>`;
      })
      .join('');
    barsEl.innerHTML = `<svg viewBox="0 0 ${w} ${h}" width="100%" height="${h}" role="img" aria-label="Units sold history">${grid}${path}${dots}${labels}</svg>`;
  }

  async function selectItem(item: ItemRow) {
    state.selected = item;
    if (chartTitle) chartTitle.textContent = item.title || 'Product';
    if (chartBack) chartBack.hidden = false;
    if (chartNote) chartNote.textContent = 'Units sold / 30 days by snapshot';
    if (barsEl) barsEl.innerHTML = '<p class="fine-print">Loading history…</p>';
    try {
      const data = await api<{ rows: HistoryPoint[] }>(`/items/${item.item_id}/history`);
      state.history = data.rows;
    } catch {
      state.history = [];
    }
    renderHistory();
    tbody?.querySelectorAll('tr').forEach((tr) => tr.classList.remove('is-selected'));
    items.indexOf(item);
    const index = items.findIndex((row) => row.item_id === item.item_id);
    if (index >= 0) tbody?.querySelectorAll('tr')[index]?.classList.add('is-selected');
  }

  function clearSelection() {
    state.selected = null;
    state.history = [];
    if (chartTitle) chartTitle.textContent = 'Top products in this list';
    if (chartBack) chartBack.hidden = true;
    renderBars();
    tbody?.querySelectorAll('tr').forEach((tr) => tr.classList.remove('is-selected'));
  }

  function renderBars() {
    if (!barsEl) return;
    const metric = METRICS[state.sort];
    const top = items.slice(0, 8);
    const max = Math.max(...top.map(metric.value), 1);
    barsEl.innerHTML = top
      .map(
        (item, index) => `<div class="bar-row" data-index="${index}">
          <span class="bar-rank">${index + 1}</span>
          <span class="bar-label" title="${escapeHtml(item.title || '')}">${escapeHtml(item.title || 'Untitled')}</span>
          <span class="bar-track"><span class="bar-fill" style="display:block;width:${Math.max(4, (metric.value(item) / max) * 100).toFixed(1)}%"></span></span>
          <span class="bar-val">${metric.format(metric.value(item))}</span>
        </div>`
      )
      .join('');
    barsEl.querySelectorAll<HTMLElement>('.bar-row').forEach((row) => {
      row.addEventListener('click', () => {
        const item = items[Number(row.dataset.index)];
        if (item) selectItem(item);
      });
    });
    if (chartNote) {
      chartNote.textContent = `${metric.label} · snapshot ${meta?.snapshot_date ?? ''}`;
    }
  }

  function renderTable() {
    if (!tbody) return;
    tbody.innerHTML = items
      .map(
        (item, index) => `
      <tr>
        <td class="rank">${index + 1}</td>
        <td class="strong">
          <span class="prod-name">${escapeHtml(item.title || 'Untitled')}</span>
          <a class="prod-link" href="${escapeHtml(item.item_url)}" target="_blank" rel="noopener noreferrer" aria-label="Open product on Shopee" title="Open on Shopee">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7"></path><path d="M9 7h8v8"></path></svg>
          </a>
        </td>
        <td>${escapeHtml(item.brand || '—')}</td>
        <td>${escapeHtml(item.category_l1 || '—')}</td>
        <td class="num strong">${fmtInt.format(item.units_sold_month ?? 0)}</td>
        <td class="num dim">${fmtInt.format(item.units_sold_total ?? 0)}</td>
        <td class="num dim">${fmtPrice(revenue(item))}</td>
        <td class="num dim">${fmtPrice(item.price)}</td>
        <td class="num dim">${item.rating ? item.rating.toFixed(2) : '—'}</td>
      </tr>`
      )
      .join('');
    tbody.querySelectorAll<HTMLElement>('tr').forEach((row, index) => {
      row.addEventListener('click', () => {
        const item = items[index];
        if (item) selectItem(item);
      });
    });
    tbody.querySelectorAll<HTMLAnchorElement>('.prod-link').forEach((link) => {
      link.addEventListener('click', (event) => event.stopPropagation());
    });
  }

  function sortByRevenue(rows: ItemRow[]): ItemRow[] {
    return [...rows].sort((a, b) => revenue(b) - revenue(a));
  }

  async function loadItems() {
    const build = (sortKey: string) => {
      const params = new URLSearchParams({ limit: '100', sort: sortKey, order: 'desc' });
      if (state.category !== 'all') params.set('category', state.category);
      if (state.query.trim()) params.set('q', state.query.trim());
      if (meta?.snapshot_date) params.set('v', meta.snapshot_date);
      return params;
    };
    try {
      let data: { rows: ItemRow[]; meta?: Meta };
      let clientSorted = false;
      try {
        data = await api<{ rows: ItemRow[]; meta?: Meta }>(`/items?${build(state.sort)}`);
      } catch (error) {
        if (state.sort !== 'revenue') throw error;
        data = await api<{ rows: ItemRow[]; meta?: Meta }>(`/items?${build('units_sold_month')}`);
        clientSorted = true;
      }
      items = clientSorted ? sortByRevenue(data.rows) : data.rows;
      if (data.meta) meta = { ...(meta as Meta), ...data.meta };
      if (state.selected) clearSelection();
      renderBars();
      renderTable();
      if (items.length) {
        await selectItem(items[0]);
      }
      if (status) {
        const cat = state.category === 'all' ? 'all industries' : state.category;
        status.textContent = `Shopee · ${cat}${state.query ? ` · “${state.query}”` : ''} · ${items.length} products · snapshot ${meta?.snapshot_date ?? ''}`;
      }
    } catch (error) {
      if (status) status.textContent = `Could not load products: ${(error as Error).message}`;
    }
  }

  async function boot() {
    try {
      const metaRes = await api<{ meta: Meta }>('/meta');
      meta = metaRes.meta;
      const catRes = await api<{ rows: CategoryRow[] }>(`/categories${meta?.snapshot_date ? `?v=${meta.snapshot_date}` : ''}`);
      categories = catRes.rows;
      renderPills();
      await loadItems();
    } catch (error) {
      if (status) status.textContent = `Backend unavailable: ${(error as Error).message}`;
    }
  }

  let searchTimer: number | undefined;
  searchInput?.addEventListener('input', () => {
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => {
      state.query = searchInput.value;
      loadItems();
    }, 220);
  });

  sortSelect?.addEventListener('change', () => {
    state.sort = sortSelect.value as SortKey;
    loadItems();
  });

  chartBack?.addEventListener('click', () => clearSelection());

  $<HTMLButtonElement>('#export')?.addEventListener('click', () => {
    const header = 'rank,item_id,title,brand,category,price,units_sold_month,revenue_month,units_sold_total,rating,url';
    const lines = items.map((i, idx) =>
      [
        idx + 1,
        i.item_id,
        `"${String(i.title || '').replace(/"/g, '""')}"`,
        `"${String(i.brand || '').replace(/"/g, '""')}"`,
        i.category_l1 || '',
        i.price ?? '',
        i.units_sold_month ?? 0,
        Math.round(revenue(i)),
        i.units_sold_total ?? 0,
        i.rating ?? '',
        i.item_url,
      ].join(',')
    );
    const blob = new Blob([[header, ...lines].join('\n')], { type: 'text/csv;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'ecommarketdata-items.csv';
    a.click();
    URL.revokeObjectURL(url);
  });

  const params = new URLSearchParams(location.search);
  if (params.get('industry')) state.category = params.get('industry') as string;
  if (params.get('q')) {
    state.query = params.get('q') as string;
    if (searchInput) searchInput.value = state.query;
  }

  boot();
</script>
