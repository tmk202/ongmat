# Telegram Bot Notification Settings (Create bot via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail / Email Notification Settings
# Default recipient for lead form submissions
LEAD_NOTIFICATION_EMAIL=giadung8686@gmail.com

# Optional: Resend API Key (https://resend.com) or Google Apps Script Webhook URL for Gmail delivery
RESEND_API_KEY=
GAS_WEBHOOK_URL=

# Private data backend (PostgreSQL shopee_output, market schema)
DATABASE_URL=
# Python used by pipeline/transform.py (needs pyarrow + psycopg2-binary)
PIPELINE_PY=

# Local backend API
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8102
# off = public read, on = require X-API-Key
BACKEND_AUTH=off
BACKEND_RATE_LIMIT=600
# Admin token for POST /v1/keys, GET /v1/keys, GET /v1/usage
BACKEND_ADMIN_TOKEN=
