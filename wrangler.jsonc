{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecommarketdata",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "ecommarketdata.com",
      "custom_domain": true
    }
  ]
}
